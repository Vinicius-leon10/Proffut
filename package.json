{
  "name": "proffut",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jogo de técnico de futebol que roda no navegador do celular, inspirado no Brasfoot.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "sim": "tsx tools/sim/simular.ts",
    "icones": "node tools/icones/gerar.mjs",
    "capturas": "node tools/e2e/jogar.mjs",
    "verificar": "npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/dm-serif-display": "5.3.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
